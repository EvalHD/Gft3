<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghost_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Chatbereich mit Anleitung oben -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ghost_surface"
                android:lineSpacingMultiplier="1.2"
                android:padding="12dp"
                android:text="So nutzt du LokalKI:\n\n• Dateien suchen: „wo ist rechnung.pdf“ oder „suche bewerbung“. Tippfehler sind egal.\n• Gerätestatus: „speicher“ oder „akku“.\n• Apps: „apps“.\n• Freie Unterhaltung: Sprachmodell lokalki-model.task in den Download-Ordner legen und die App neu starten.\n\nSchreib deine Nachricht unten und tippe auf Senden."
                android:textColor="@color/ghost_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chatLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:padding="8dp"
                android:textColor="@color/ghost_text"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Eingabefeld unten -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/ghost_surface"
            android:hint="Schreib mir etwas…"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/ghost_text"
            android:textColorHint="@color/ghost_muted" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/ghost_violet"
            android:text="Senden"
            android:textColor="@color/ghost_text" />
    </LinearLayout>
</LinearLayout>
